<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms uniquement pour l'icone de la zone de notification (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lueur</AssemblyName>
    <RootNamespace>Lueur</RootNamespace>
    <ApplicationIcon>Assets\lueur.ico</ApplicationIcon>
    <!-- Version publiee : la Release GitHub s'appelle v<Version>, et Lueur la compare a la sienne. -->
    <Version>1.2.0</Version>
    <Product>Lueur</Product>
    <Description>Eclairage chambre IKEA + RGB du PC</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
  </ItemGroup>

</Project>
