<Window x:Class="Lueur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lueur" Width="1140" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- Fond : sombre et legerement teinte par la couleur actuelle (halo d'ambiance).
             Opaque : sinon les boutons de titre de Windows, dessines sous la fenetre, se voient en transparence. -->
        <Border Background="#0A0A0F"/>
        <Ellipse x:Name="AmbientGlow" Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-340,-300,0,0" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="AmbientStop" Color="#8B5CF6" Offset="0"/>
                    <GradientStop Color="#008B5CF6" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== Barre de titre ========== -->
            <Grid Margin="22,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="26" Height="26">
                        <Ellipse StrokeThickness="3" Stroke="{DynamicResource AccentBrush}">
                            <Ellipse.Effect><BlurEffect Radius="6"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse StrokeThickness="2.5" Stroke="White" Margin="2"/>
                    </Grid>
                    <TextBlock Text="Lueur" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,1" VerticalAlignment="Center"/>
                    <TextBlock Text="chambre &amp; setup" Style="{StaticResource Caption}" Margin="10,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Pastilles d'etat -->
                    <Border CornerRadius="12" Background="#12FFFFFF" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="IkeaDot" Width="8" Height="8" Fill="#6C6C7A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IkeaStatus" Text="DIRIGERA" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Background="#12FFFFFF" Padding="12,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PcDot" Width="8" Height="8" Fill="#6C6C7A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PcStatus" Text="OpenRGB" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13" Click="Settings_Click" ToolTip="Reglages"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Reduire"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer (reste dans la barre des taches)"/>
                </StackPanel>
            </Grid>

            <!-- ========== Contenu ========== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="22,6,22,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne gauche -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="22,26,22,22">
                            <StackPanel>
                                <Grid x:Name="OrbHost" Width="250" Height="250" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Orb_Click" ToolTip="Cliquer pour tout allumer / eteindre">
                                    <Ellipse x:Name="OrbGlow" Width="190" Height="190" Opacity="0.7">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="GlowBrush" Color="#8B5CF6"/>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Width="168" Height="168">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.45,0.42" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop x:Name="OrbHi" Color="#F4EEFF" Offset="0"/>
                                                <GradientStop x:Name="OrbMid" Color="#8B5CF6" Offset="0.5"/>
                                                <GradientStop x:Name="OrbEdge" Color="#3A2470" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="168" Height="168" Stroke="#30FFFFFF" StrokeThickness="1"/>
                                    <TextBlock x:Name="OrbIcon" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="LookLabel" Text="Violet · 80 %" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock x:Name="LookSub" Text="Chambre + PC synchronises" HorizontalAlignment="Center" Style="{StaticResource Caption}"/>

                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource PrimaryButton}" Click="AllOn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,1,9,0"/>
                                            <TextBlock Text="Tout allumer"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="AllOff_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,1,9,0"/>
                                            <TextBlock Text="Tout eteindre"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Mode ecran" Style="{StaticResource SectionTitle}"/>
                                    <Border x:Name="ScreenLiveBadge" HorizontalAlignment="Right" CornerRadius="8" Background="#33EF4444" Padding="8,2" Visibility="Collapsed">
                                        <TextBlock Text="EN DIRECT" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5"/>
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="ScreenSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="Screen_Click">
                                    <StackPanel>
                                        <TextBlock Text="Couleurs de l'ecran en direct"/>
                                        <TextBlock Text="Films, jeux, musique : le setup suit l'image" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ScreenRoomSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="True" Click="ScreenRoom_Click">
                                    <StackPanel>
                                        <TextBlock Text="Les lampes de la chambre aussi"/>
                                        <TextBlock Text="Plus lentes que le PC (une mise a jour par seconde)" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Synchronisation" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="SyncSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="Sync_Click">
                                    <StackPanel>
                                        <TextBlock Text="Le PC suit la chambre"/>
                                        <TextBlock Text="Siri, Alexa, app IKEA, interrupteurs" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="Startup_Click">
                                    <StackPanel>
                                        <TextBlock Text="Lancer avec Windows"/>
                                        <TextBlock Text="Demarre discretement dans la barre des taches" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tout allumer" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="Ctrl + Alt + Debut" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tout eteindre" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="Ctrl + Alt + Fin" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Grid>
                                <Button Style="{StaticResource GhostButton}" Height="38" FontSize="12" Margin="0,16,0,0" Click="Shortcuts_Click" Content="Creer les raccourcis sur le Bureau"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Colonne droite -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Couleur" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="12" Background="#0FFFFFFF" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeColor" Style="{StaticResource Segment}" Content="Couleur" GroupName="Mode" IsChecked="True" Checked="Mode_Checked"/>
                                            <RadioButton x:Name="ModeWhite" Style="{StaticResource Segment}" Content="Blanc" GroupName="Mode" Checked="Mode_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="ColorPanel" Margin="0,18,0,0">
                                    <TextBlock Text="Teinte" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <Slider x:Name="HueSlider" Style="{StaticResource FancySlider}" Minimum="0" Maximum="359" Value="265" ValueChanged="Color_Changed">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF0000" Offset="0"/>
                                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                    <TextBlock Text="Saturation" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                                    <Slider x:Name="SatSlider" Style="{StaticResource FancySlider}" Minimum="0" Maximum="100" Value="85" ValueChanged="Color_Changed">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop x:Name="SatEnd" Color="#8B5CF6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                </StackPanel>

                                <StackPanel x:Name="WhitePanel" Margin="0,18,0,0" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Temperature" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="KelvinLabel" Text="2700 K" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TempSlider" Style="{StaticResource FancySlider}" Minimum="2200" Maximum="4000" Value="2700" ValueChanged="Color_Changed">
                                        <Slider.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF9A3C" Offset="0"/>
                                                <GradientStop Color="#FFD7A8" Offset="0.5"/>
                                                <GradientStop Color="#E9F0FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Slider.Background>
                                    </Slider>
                                </StackPanel>

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="Luminosite" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="LevelLabel" Text="80 %" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LevelSlider" Style="{StaticResource FancySlider}" Minimum="1" Maximum="100" Value="80" ValueChanged="Level_Changed">
                                    <Slider.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#111114" Offset="0"/>
                                            <GradientStop x:Name="LevelEnd" Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Slider.Background>
                                </Slider>

                                <WrapPanel x:Name="Swatches" Margin="-4,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="17,20,17,17">
                            <StackPanel>
                                <TextBlock Text="Ambiances" Style="{StaticResource SectionTitle}" Margin="5,0,0,8"/>
                                <UniformGrid x:Name="Scenes" Columns="3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Eclairage adaptatif" Style="{StaticResource SectionTitle}"/>
                                    <Border x:Name="AdaptiveBadge" HorizontalAlignment="Right" CornerRadius="8" Background="#3334D399" Padding="8,2" Visibility="Collapsed">
                                        <TextBlock Text="ACTIF" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                                    </Border>
                                </Grid>
                                <CheckBox x:Name="AdaptiveSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="Adaptive_Click">
                                    <StackPanel>
                                        <TextBlock Text="La lumiere suit la journee, en couleurs"/>
                                        <TextBlock Text="Chambre + PC. Choisir une couleur a la main le met en pause." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border HorizontalAlignment="Left" CornerRadius="12" Background="#0FFFFFFF" Padding="3" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ProfAuto" Style="{StaticResource Segment}" Content="Selon la meteo" GroupName="Prof" Tag="auto" Checked="Profile_Checked"/>
                                        <RadioButton x:Name="ProfSun" Style="{StaticResource Segment}" Content="Soleil" GroupName="Prof" Tag="sun" Checked="Profile_Checked"/>
                                        <RadioButton x:Name="ProfRain" Style="{StaticResource Segment}" Content="Pluie" GroupName="Prof" Tag="rain" Checked="Profile_Checked"/>
                                        <RadioButton x:Name="ProfCloud" Style="{StaticResource Segment}" Content="Gris" GroupName="Prof" Tag="cloud" Checked="Profile_Checked"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="AdaptiveMood" Style="{StaticResource Caption}" Margin="0,12,0,10" TextWrapping="Wrap"/>
                                <Grid x:Name="Timeline" Height="30" SizeChanged="Timeline_SizeChanged">
                                    <Border x:Name="TimelineBar" CornerRadius="9" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                                    <Border x:Name="NowMarker" Width="3" CornerRadius="1.5" Background="White" HorizontalAlignment="Left" Margin="0,-4">
                                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="White"/></Border.Effect>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0h" Style="{StaticResource Caption}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="6h" Style="{StaticResource Caption}" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="12h" Style="{StaticResource Caption}" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="18h" Style="{StaticResource Caption}" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="24h" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Routines" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="WeatherLabel" Text="Meteo..." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="DefaultRoutinesButton" Style="{StaticResource GhostButton}" Height="34" FontSize="12" Content="Creer ma journee type" Margin="0,0,8,0" Click="DefaultRoutines_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Height="34" FontSize="12" Content="+ Ajouter" Click="AddRoutine_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="RoutinesEmpty" Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Text="Aucune routine. « Creer ma journee type » ajoute reveil, journee, coucher du soleil, soiree, nuit, jour de pluie et grand soleil."/>
                                <ItemsControl x:Name="RoutineList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,9" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="RoutineSwitch_Click" Tag="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CaptionButton}" Width="34" FontSize="12" Content="&#xE768;" ToolTip="Lancer maintenant" Click="RunRoutine_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource CaptionButton}" Width="34" FontSize="12" Content="&#xE70F;" ToolTip="Modifier" Click="EditRoutine_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource CaptionButton}" Width="34" FontSize="12" Content="&#xE74D;" ToolTip="Supprimer" Click="DeleteRoutine_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Chambre" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="IKEA" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="RoomEmpty" Text="Pas encore connecte a la DIRIGERA." Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="RoomList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,9" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding IsReachable}" Click="LightSwitch_Click" Tag="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="RepairButton" Style="{StaticResource GhostButton}" Height="36" FontSize="12" Margin="0,14,0,0" Content="Appairer une DIRIGERA" Click="ShowPairing_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="PC" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="OpenRGB" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="PcEmpty" Text="Connexion a OpenRGB..." Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="PcList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,9" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Included, Mode=OneWay}" Click="PcSwitch_Click" Tag="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox x:Name="GHubSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="GHub_Click">
                                        <StackPanel>
                                            <TextBlock Text="Fermer G HUB automatiquement"/>
                                            <TextBlock Text="Il bloque les couleurs du micro Yeti X" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Button Style="{StaticResource GhostButton}" Height="36" FontSize="12" Margin="0,14,0,0" Content="Reconnecter OpenRGB" Click="ReconnectPc_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ========== Bandeau de mise a jour ========== -->
        <Border x:Name="UpdateBanner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,60,0,0" CornerRadius="14"
                Background="#F21C1C24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="16,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UpdateBannerText" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource PrimaryButton}" Height="32" FontSize="12" Padding="14,0" Content="Redemarrer maintenant" Click="UpdateRestart_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Margin="6,0,0,0" Click="UpdateBannerClose_Click" ToolTip="Plus tard"/>
            </StackPanel>
        </Border>

        <!-- ========== Reglages ========== -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
            <Border Background="#D9050508" MouseLeftButtonUp="SettingsBackdrop_Click"/>
            <Border Style="{StaticResource Card}" Background="#F2141419" Width="540" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Reglages" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="SettingsClose_Click"/>
                    </Grid>

                    <TextBlock Text="Ville (meteo, lever et coucher du soleil)" Style="{StaticResource Caption}" Margin="0,20,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CityBox" Style="{StaticResource Field}" KeyDown="CityBox_KeyDown"/>
                        <Button x:Name="CitySearchButton" Grid.Column="2" Style="{StaticResource GhostButton}" Height="44" FontSize="13" Content="Chercher" Click="CitySearch_Click"/>
                    </Grid>
                    <ItemsControl x:Name="CityResults" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CityCurrent" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,14"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Mises a jour" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource GhostButton}" Height="34" FontSize="12" HorizontalAlignment="Right" Content="Verifier maintenant" Click="CheckUpdate_Click"/>
                    </Grid>
                    <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Click="AutoUpdate_Click">
                        <StackPanel>
                            <TextBlock Text="Mises a jour automatiques"/>
                            <TextBlock Text="Telechargees depuis GitHub, installees au prochain demarrage" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <Border Height="1" Background="#14FFFFFF" Margin="0,18,0,14"/>
                    <TextBlock Text="Lumen et autres applis" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Lumen detecte Lueur tout seul. Toute appli, raccourci ou script peut piloter Lueur : --on, --off, --toggle, --warm, --screen, --scene &quot;Nom&quot;, --color #RRGGBB, --level 0-100, --adaptive auto|off. L'etat en direct est dans %APPDATA%\Lueur\state.json."/>
                    <Button Style="{StaticResource GhostButton}" Height="34" FontSize="12" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Ouvrir le dossier de Lueur" Click="OpenDataFolder_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Saisie d'un texte (nom d'ambiance...) ========== -->
        <Grid x:Name="PromptOverlay" Visibility="Collapsed">
            <Border Background="#D9050508"/>
            <Border Style="{StaticResource Card}" Background="#F2141419" Width="420" VerticalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock x:Name="PromptTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PromptLabel" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <TextBox x:Name="PromptBox" Style="{StaticResource Field}" KeyDown="PromptBox_KeyDown"/>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="PromptCancel_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Valider" Click="PromptOk_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Editeur de routine ========== -->
        <Grid x:Name="RoutineOverlay" Visibility="Collapsed">
            <Border Background="#D9050508"/>
            <Border Style="{StaticResource Card}" Background="#F2141419" Width="520" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock x:Name="RoutineEditorTitle" Text="Nouvelle routine" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>

                    <TextBlock Text="Nom" Style="{StaticResource Caption}" Margin="0,18,0,6"/>
                    <TextBox x:Name="RoutineName" Style="{StaticResource Field}"/>

                    <TextBlock Text="Quand" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <Border HorizontalAlignment="Left" CornerRadius="12" Background="#0FFFFFFF" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TrigTime" Style="{StaticResource Segment}" Content="A une heure" GroupName="Trig" IsChecked="True" Checked="RoutineForm_Changed"/>
                            <RadioButton x:Name="TrigSunrise" Style="{StaticResource Segment}" Content="Lever du soleil" GroupName="Trig" Checked="RoutineForm_Changed"/>
                            <RadioButton x:Name="TrigSunset" Style="{StaticResource Segment}" Content="Coucher du soleil" GroupName="Trig" Checked="RoutineForm_Changed"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TimeField">
                            <TextBlock x:Name="TimeFieldLabel" Text="Heure (HH:mm)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RoutineTime" Style="{StaticResource Field}" Text="08:00"/>
                        </StackPanel>
                        <StackPanel x:Name="OffsetField" Visibility="Collapsed">
                            <TextBlock Text="Decalage en minutes (-30 = avant)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RoutineOffset" Style="{StaticResource Field}" Text="0"/>
                        </StackPanel>
                        <StackPanel x:Name="UntilField" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Text="Surveiller jusqu'a (HH:mm)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RoutineUntil" Style="{StaticResource Field}" Text="18:00"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Jours" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <StackPanel x:Name="DayChips" Orientation="Horizontal"/>

                    <TextBlock Text="Meteo" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <Border HorizontalAlignment="Left" CornerRadius="12" Background="#0FFFFFFF" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CondAlways" Style="{StaticResource Segment}" Content="Peu importe" GroupName="Cond" IsChecked="True" Checked="RoutineForm_Changed"/>
                            <RadioButton x:Name="CondRain" Style="{StaticResource Segment}" Content="Pluie" GroupName="Cond" Checked="RoutineForm_Changed"/>
                            <RadioButton x:Name="CondClear" Style="{StaticResource Segment}" Content="Soleil" GroupName="Cond" Checked="RoutineForm_Changed"/>
                            <RadioButton x:Name="CondCloudy" Style="{StaticResource Segment}" Content="Gris" GroupName="Cond" Checked="RoutineForm_Changed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Action" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                    <Border HorizontalAlignment="Left" CornerRadius="12" Background="#0FFFFFFF" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ActLook" Style="{StaticResource Segment}" GroupName="Act" IsChecked="True" Checked="RoutineForm_Changed">
                                <TextBlock x:Name="ActLookLabel" Text="Couleur actuelle"/>
                            </RadioButton>
                            <RadioButton x:Name="ActOff" Style="{StaticResource Segment}" Content="Tout eteindre" GroupName="Act" Checked="RoutineForm_Changed"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Astuce : choisis d'abord la couleur ou l'ambiance dans Lueur, puis cree la routine."/>

                    <TextBlock x:Name="RoutineError" Foreground="#FF8A8A" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="RoutineCancel_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="RoutineSave_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Appairage DIRIGERA ========== -->
        <Grid x:Name="PairingOverlay" Visibility="Collapsed">
            <Border Background="#D9050508"/>
            <Border Style="{StaticResource Card}" Background="#F2141419" Width="460" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <TextBlock Text="Connecter ta DIRIGERA" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"
                               Text="Connexion directe sur ton reseau local, sans cloud. Lueur cherche la passerelle, puis il faudra appuyer sur le bouton ACTION situe sous la DIRIGERA."/>
                    <TextBlock Text="Adresse IP" Style="{StaticResource Caption}" Margin="0,22,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Style="{StaticResource Field}"/>
                        <Button x:Name="DiscoverButton" Grid.Column="2" Style="{StaticResource GhostButton}" Height="44" FontSize="13" Content="Rechercher" Click="Discover_Click"/>
                    </Grid>
                    <Border x:Name="PairHint" CornerRadius="14" Background="#12FFFFFF" Padding="16" Margin="0,18,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PairCountdown" Text="60" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Width="52" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"
                                       Text="Appuie maintenant sur le bouton ACTION sous la DIRIGERA (le petit bouton rond, a cote du port USB-C)."/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PairError" Foreground="#FF8A8A" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PairLaterButton" Style="{StaticResource GhostButton}" Content="Plus tard" Click="PairLater_Click"/>
                        <Button x:Name="PairButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Appairer" Click="Pair_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== Notification ========== -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" CornerRadius="14"
                Background="#F21C1C24" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="18,11" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13" MaxWidth="640" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
